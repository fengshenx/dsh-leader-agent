node_modules/
*.log
.DS_Store

# npm pack / publish 的 tarball（发布包内容由 npm run verify:pack 校验，产物不入库）
*.tgz

# client 构建产物（npm run build:client 生成，发布时由 prepublishOnly 重建）
lib/

# 并行开发用的 worktree（git worktree add 建在本仓内）
.worktrees/

# 开发实例的数据根（npm run dev 建的会话、项目、卡片与派生 profile），
# 以及 e2e 的截图（.dev/e2e-artifacts/，给人看的临时证据，不入库）
.dev/
