{
  "name": "dsh-leader-kit",
  "version": "0.2.0",
  "description": "Leader-driven dispatch for DeepSeek Harness: protocol skills, project bootstrap, and a delivery board.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengshenx/dsh-leader-kit.git"
  },
  "homepage": "https://github.com/fengshenx/dsh-leader-kit#readme",
  "bugs": {
    "url": "https://github.com/fengshenx/dsh-leader-kit/issues"
  },
  "exports": {
    ".": "./index.js",
    "./src/host": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src/**",
    "lib/client.js",
    ".agents/skills/**",
    "locale/*.json",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node scripts/verify-coverage.mjs",
    "e2e": "npm run build:client && node --test --test-force-exit \"tests/e2e/*.e2e.js\"",
    "e2e:install": "playwright install chromium",
    "check": "node scripts/verify-agent-note-format.mjs && node scripts/verify-doc-tool-names.mjs && node scripts/verify-doc-budgets.mjs && node scripts/check-syntax.mjs && node scripts/verify-coverage.mjs",
    "build:client": "node build/client.mjs",
    "dev": "node scripts/dev.mjs",
    "desktop": "node scripts/desktop.mjs",
    "start": "node scripts/start.mjs",
    "worktree:spawn": "node scripts/worktree-spawn.mjs",
    "worktree:prune": "node scripts/worktree-prune.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "release:check": "npm run check && npm run build:client && npm run verify:pack",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "leader",
    "dispatch",
    "delivery-board"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "minidenticons": "^4.2.1",
    "playwright": "^1.64.1"
  }
}
